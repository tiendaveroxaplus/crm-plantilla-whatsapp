# Infraestructura
DATABASE_URL=postgresql://crm_user:CHANGE_ME@postgres:5432/crm
REDIS_URL=redis://redis:6379
AUTH_SECRET=replace_with_a_long_random_secret
CRM_ADMIN_EMAIL=admin@tuempresa.com
CRM_ADMIN_PASSWORD=replace_with_a_long_unique_password
CRM_BRAND_NAME=Mi Negocio

# YCloud
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_NUMBER=
YCLOUD_WEBHOOK_SECRET=
# URL pública del CRM, necesaria para que WhatsApp descargue las imágenes de productos.
APP_BASE_URL=https://tu-crm.example.com

# IA: Gemini se configura exclusivamente en el servidor
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite
GOOGLE_AI_INPUT_COST_PER_MILLION=0
GOOGLE_AI_OUTPUT_COST_PER_MILLION=0
USD_TO_PEN_EXCHANGE_RATE=3.3665
AI_TEST_PHONE=51XXXXXXXXX

# Opcional: carga de imágenes del catálogo a S3/R2 desde /knowledge.
# Configura un bucket de escritura privada y un dominio HTTPS público de lectura.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
# Opcional: modelo de respaldo para transcribir audios si el principal falla (p. ej. gemini-3.6-flash).
GOOGLE_AI_AUDIO_MODEL=
